{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "uv sync --directory ../backend --extra dev",
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,green \"uv run --directory ../backend uvicorn src.server:app --port 8000\" \"node node_modules/vite/bin/vite.js\"",
    "dev:web": "vite",
    "dev:api": "uv run --directory ../backend uvicorn src.server:app --port 8000",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "npm run test:backend && npm run test:frontend",
    "test:frontend": "vitest run",
    "test:backend": "uv run --directory ../backend --extra dev python -m pytest -m fast",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.5",
    "jsdom": "^28.1.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
